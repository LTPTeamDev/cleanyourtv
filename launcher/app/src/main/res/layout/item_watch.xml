<?xml version="1.0" encoding="utf-8"?>
<!-- One Continue watching row: the poster, the title and where you stopped. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="14dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/poster"
        android:layout_width="48dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:background="#33FFFFFF"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@string/font_medium"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@drawable/pill_text_dim"
            android:duplicateParentState="true"
            android:textSize="11sp"
            android:fontFamily="@string/font_body"
            android:letterSpacing="0.04"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
